parameters:
	level: 5
	paths:
		- Classes
		- Configuration
	excludePaths:
		- .build
	ignoreErrors:
		# Version switch between TYPO3 v13 (FlexFormService) and v14 (FlexFormTools)
		-
			identifier: function.alreadyNarrowedType
			path: Classes/Command/MapCacheCommandController.php
			reportUnmatched: false
		-
			identifier: method.notFound
			message: '#FlexFormTools::convertFlexFormContentToArray#'
			path: Classes/Command/MapCacheCommandController.php
			reportUnmatched: false
		# Compatibility with NDK versions without Configuration::addMiddleware()
		-
			identifier: function.alreadyNarrowedType
			message: '#addMiddleware#'
			reportUnmatched: false
		# Version switches between TYPO3 v13 and v14
		-
			message: '#SystemResource\\(SystemResourceFactory|Publishing\\SystemResourcePublisherInterface)#'
			reportUnmatched: false
		-
			message: '#ExtensionUtility::registerPlugin\(\) invoked with 7 parameters#'
			reportUnmatched: false
		-
			message: '#AbstractListTypeToCTypeUpdateCompat#'
			reportUnmatched: false
		# SetDefinition::$routeEnhancers exists since TYPO3 14
		-
			identifier: property.notFound
			message: '#SetDefinition::\$routeEnhancers#'
			path: Classes/Routing/SetRouteEnhancers.php
			reportUnmatched: false
